# =============================================================================
# Sentiment Analysis on Crypto - Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL SETTINGS
# -----------------------------------------------------------------------------
ENVIRONMENT=development
COMPOSE_PROJECT_NAME=sentiman

# -----------------------------------------------------------------------------
# MONGODB DATABASE
# -----------------------------------------------------------------------------
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=change_me_in_production
MONGODB_CONNECTION_STRING=mongodb://admin:change_me_in_production@mongodb:27017
MONGODB_DATABASE=blog-data

# -----------------------------------------------------------------------------
# KAFKA MESSAGE QUEUE
# -----------------------------------------------------------------------------
KAFKA_TOPIC=coinmarketcap-news
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_LOG_RETENTION_BYTES=4073741824
KAFKA_LOG_SEGMENT_BYTES=1073741824

# -----------------------------------------------------------------------------
# MLFLOW EXPERIMENT TRACKING
# -----------------------------------------------------------------------------
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow123_change_me
MLFLOW_POSTGRES_DB=mlflow

# MinIO (S3-compatible storage for MLflow artifacts)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123_change_me

# -----------------------------------------------------------------------------
# AIRFLOW WORKFLOW ORCHESTRATION
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow_change_me

# -----------------------------------------------------------------------------
# LLM PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Choose LLM provider: "gemini" (recommended, free) or "together"
LLM_PROVIDER=gemini

# Google Gemini API (FREE and FAST - Recommended!)
# Get your FREE API key at: https://makersuite.google.com/app/apikey
# Or: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Together AI API (Alternative, paid)
# Get from: https://api.together.xyz/
# Only needed if LLM_PROVIDER=together
TOGETHER_API_KEY=

# -----------------------------------------------------------------------------
# BITCOIN DATA API
# -----------------------------------------------------------------------------
# Coinranking - For Bitcoin Price Data (REQUIRED)
# Get FREE API key from: https://developers.coinranking.com/
COINRANKING_API_KEY=your_coinranking_key_here

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------

# Discord Webhooks (Optional - for notifications)
DISCORD_WEBHOOK_URL_ERROR=
DISCORD_WEBHOOK_URL_SUCCESS=

# Twitter/X API (Optional - for Twitter crawling)
TWITTER_AUTH_TOKEN=

# New York Times API (Optional)
NEW_YORK_TIME_TOKEN=

# -----------------------------------------------------------------------------
# PROXY SETTINGS (Optional)
# -----------------------------------------------------------------------------
PROXY_AUTH_USERNAME=
PROXY_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# NOTES:
# -----------------------------------------------------------------------------
# 1. Never commit .env file to git (already in .gitignore)
# 2. Change all passwords before production deployment
# 3. GEMINI_API_KEY (or TOGETHER_API_KEY) is REQUIRED for sentiment analysis
# 4. COINRANKING_API_KEY is REQUIRED for Bitcoin price data
# 5. Gemini API is FREE and faster - recommended for most users
# 6. Keep your API keys secure and rotate them regularly
# 7. Use strong passwords (16+ characters with mixed case, numbers, symbols)

# -----------------------------------------------------------------------------
# HOW TO GET API KEYS:
# -----------------------------------------------------------------------------
# 
# 1. GEMINI API (FREE - Recommended):
#    - Visit: https://makersuite.google.com/app/apikey
#    - Click "Create API Key"
#    - Copy the key and paste above
#
# 2. COINRANKING API (FREE):
#    - Visit: https://developers.coinranking.com/
#    - Sign up for free account
#    - Go to API Dashboard
#    - Copy your API key
#
# 3. TOGETHER AI (Paid - Alternative):
#    - Visit: https://api.together.xyz/
#    - Sign up and add credits
#    - Get API key from dashboard
